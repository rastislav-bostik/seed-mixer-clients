{
  "$description": "Stack-agnostic design tokens for seed-mixer clients. Loosely DTCG-shaped (https://design-tokens.github.io/community-group/format/). Each client transforms this into its native idiom at build time.",
  "color": {
    "brand": {
      "meadow":   { "$value": "#5B8C4F", "$type": "color", "$description": "primary green — meadow grass" },
      "bloom":    { "$value": "#E8A33A", "$type": "color", "$description": "accent — wildflower yellow" },
      "soil":     { "$value": "#6B4423", "$type": "color", "$description": "earth tone" }
    },
    "neutral": {
      "ink":      { "$value": "#1A1A1A", "$type": "color" },
      "muted":    { "$value": "#6E6E6E", "$type": "color" },
      "line":     { "$value": "#E5E5E5", "$type": "color" },
      "surface":  { "$value": "#FAFAF7", "$type": "color" },
      "white":    { "$value": "#FFFFFF", "$type": "color" }
    },
    "status": {
      "inStock":  { "$value": "#3D9970", "$type": "color" },
      "warn":     { "$value": "#D97706", "$type": "color" },
      "error":    { "$value": "#B91C1C", "$type": "color" }
    }
  },
  "spacing": {
    "xs": { "$value": "4",  "$type": "dimension" },
    "sm": { "$value": "8",  "$type": "dimension" },
    "md": { "$value": "16", "$type": "dimension" },
    "lg": { "$value": "24", "$type": "dimension" },
    "xl": { "$value": "32", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "4",  "$type": "dimension" },
    "md": { "$value": "8",  "$type": "dimension" },
    "lg": { "$value": "16", "$type": "dimension" }
  },
  "typography": {
    "fontFamily": {
      "sans":   { "$value": "Inter, system-ui, sans-serif" },
      "serif":  { "$value": "Lora, Georgia, serif" }
    },
    "fontSize": {
      "xs":  { "$value": "12", "$type": "dimension" },
      "sm":  { "$value": "14", "$type": "dimension" },
      "md":  { "$value": "16", "$type": "dimension" },
      "lg":  { "$value": "20", "$type": "dimension" },
      "xl":  { "$value": "28", "$type": "dimension" }
    }
  }
}
