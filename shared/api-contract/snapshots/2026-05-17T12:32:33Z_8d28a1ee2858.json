      "ProductsResponse": {
        "properties": {
          "filters": {
            "properties": {
              "category": {
                "nullable": true,
                "type": "string"
              },
              "contains": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "manufacturer": {
                "nullable": true,
                "type": "string"
              },
              "source": {
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": true,
                "type": "string"
              }
            },
            "type": "object"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            },
            "type": "array"
          },
          "resolvedContains": {
            "description": "Canonical speciesIds that `contains` terms were resolved to. Useful for debugging fuzzy matches — shows which IDs the AND filter was applied against.",
            "example": [
              "trifolium-pratense",
              "festuca-rubra"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "total": {
            "example": 1267,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "filters",
          "products"
        ],
        "type": "object"
      },
      "SearchHit": {
        "properties": {
          "cultivars": {
            "example": [
              "Amos",
              "Kvarta"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "czechName": {
            "example": "Červený jetel",
            "type": "string"
          },
          "id": {
            "description": "Canonical speciesId.",
            "example": "trifolium-pratense",
            "type": "string"
          },
          "latinName": {
            "example": "Trifolium pratense",
            "type": "string"
          },
          "productCount": {
            "description": "Number of products that reference this species.",
            "example": 14,
            "type": "integer"
          },
          "score": {
            "description": "Orama BM25 relevance score.",
            "example": 1.42,
            "type": "number"
          }
        },
        "required": [
          "id",
          "score",
          "latinName",
          "productCount"
        ],
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array"
          },
          "query": {
            "description": "The query string as received.",
            "example": "jetel",
            "type": "string"
          },
          "total": {
            "description": "Number of hits returned.",
            "example": 8,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "query",
          "hits"
        ],
        "type": "object"
      },
      "Species": {
        "properties": {
          "cultivars": {
            "description": "Known cultivar names for this species.",
            "example": [
              "Amos",
              "Kvarta"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "czechName": {
            "example": "Červený jetel",
            "type": "string"
          },
          "growing": {
            "$ref": "#/components/schemas/SpeciesGrowing"
          },
          "id": {
            "description": "Canonical identifier — lowercased Latin name with spaces replaced by dashes.",
            "example": "trifolium-pratense",
            "type": "string"
          },
          "latinName": {
            "example": "Trifolium pratense",
            "type": "string"
          },
          "usedInProducts": {
            "description": "Product IDs that reference this species via Ingredient.speciesId.",
            "example": [
              "planta-mixes/lucelka",
              "kvetnatelouky/mix-01"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "latinName",
          "usedInProducts"
        ],
        "type": "object"
      },
      "SpeciesGrowing": {
        "description": "Growing-condition data sourced from Planta Naturalis species pages (populated when available).",
        "properties": {
          "bloomingMonths": {
            "description": "Calendar months (1=Jan … 12=Dec) when the species blooms.",
            "example": [
              6,
              7,
              8
            ],
            "items": {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            "type": "array"
          },
          "flowerColor": {
            "example": "pink-purple",
            "type": "string"
          },
          "heightCm": {
            "description": "Height range in centimetres.",
            "nullable": true,
            "properties": {
              "max": {
                "example": 80,
                "type": "number"
              },
              "min": {
                "example": 30,
                "type": "number"
              }
            },
            "required": [
