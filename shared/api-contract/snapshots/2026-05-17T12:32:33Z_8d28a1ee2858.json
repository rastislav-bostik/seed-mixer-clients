{
  "components": {
    "parameters": {},
    "schemas": {
      "CategoriesResponse": {
        "properties": {
          "categories": {
            "items": {
              "properties": {
                "category": {
                  "example": "meadow",
                  "type": "string"
                },
                "productCount": {
                  "example": 430,
                  "type": "integer"
                }
              },
              "required": [
                "category",
                "productCount"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "Number of distinct categories.",
            "example": 8,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "categories"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "example": "product not found: planta-mixes/nonexistent",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FuzzyResolveError": {
        "properties": {
          "error": {
            "example": "no species matches: ZZZZNONSENSE",
            "type": "string"
          },
          "suggestions": {
            "description": "Top search hits (may be empty) for the unresolvable term.",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array"
          }
        },
        "required": [
          "error",
          "suggestions"
        ],
        "type": "object"
      },
      "Ingredient": {
        "properties": {
          "cultivar": {
            "description": "Cultivar name when the source specifies one.",
            "example": "Amos",
            "type": "string"
          },
          "czechName": {
            "description": "Czech vernacular name of the species.",
            "example": "Červený jetel",
            "type": "string"
          },
          "latinName": {
            "description": "Binomial Latin name of the species.",
            "example": "Trifolium pratense",
            "type": "string"
          },
          "percentage": {
            "description": "Share of this ingredient in the seed mixture by weight (0–100). Single-species products use 100.",
            "example": 30,
            "type": "number"
          },
          "speciesId": {
            "description": "Canonical species identifier (slug). Null until the linker pass resolves it.",
            "example": "trifolium-pratense",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "percentage"
        ],
        "type": "object"
      },
      "ManufacturerSummary": {
        "properties": {
          "bySource": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Product count broken down by scraper source.",
            "example": {
              "agrogen": 7,
              "planta-mixes": 35
            },
            "type": "object"
          },
          "manufacturer": {
            "example": "Agrostis Trávníky",
            "type": "string"
          },
          "productCount": {
            "description": "Total number of products from this manufacturer across all sources.",
            "example": 42,
            "type": "integer"
          }
        },
        "required": [
          "manufacturer",
          "productCount",
          "bySource"
        ],
        "type": "object"
      },
      "ManufacturersResponse": {
        "properties": {
          "manufacturers": {
            "items": {
              "$ref": "#/components/schemas/ManufacturerSummary"
            },
            "type": "array"
          },
          "total": {
            "description": "Total product count across all manufacturers.",
            "example": 1267,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "manufacturers"
        ],
        "type": "object"
      },
      "Offering": {
        "properties": {
          "inStock": {
            "description": "Availability flag from the source page.",
            "example": true,
            "nullable": true,
            "type": "boolean"
          },
          "notes": {
            "description": "Free-text availability or quality note from the source.",
            "example": "vyprodáno",
            "nullable": true,
            "type": "string"
          },
          "packLabel": {
            "description": "Human-readable pack size label from the source.",
            "example": "1 kg",
            "type": "string"
          },
          "priceCzk": {
            "description": "Gross price including VAT in CZK, when published by the source.",
            "example": 349,
            "nullable": true,
            "type": "number"
          },
          "priceCzkExclVat": {
            "description": "Price excluding VAT in CZK.",
            "example": 288.43,
            "nullable": true,
            "type": "number"
          },
          "pricePerKgCzk": {
            "description": "Derived price-per-kg for cross-size comparison.",
            "example": 349,
            "nullable": true,
            "type": "number"
          },
          "vatPercent": {
            "description": "VAT rate applied, e.g. 21.",
            "example": 21,
            "nullable": true,
            "type": "number"
          },
          "weightGrams": {
            "description": "Pack weight in grams. Null for live plants and variable-weight items.",
            "example": 1000,
            "nullable": true,
            "type": "number"
          }
        },
        "required": [
          "packLabel"
        ],
        "type": "object"
      },
      "Product": {
        "oneOf": [
          {
            "properties": {
              "_warnings": {
                "description": "OCR / parser caveats surfaced to the consumer.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "categories": {
                "description": "Multi-membership category list. A product may belong to several categories.",
                "example": [
                  "meadow",
                  "pollinator-friendly"
                ],
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "composition": {
                "description": "Seed composition. Mixtures: many entries. Single-species: one entry at percentage=100.",
                "items": {
                  "$ref": "#/components/schemas/Ingredient"
                },
                "type": "array"
              },
              "description": {
                "description": "Long-form product description, may contain HTML.",
                "nullable": true,
                "type": "string"
              },
              "id": {
                "description": "Stable cross-source identifier: `{source}/{slug}`.",
                "example": "planta-mixes/krasova-kvetna-smes",
                "type": "string"
              },
              "images": {
                "description": "Image URLs in priority order.",
                "example": [
                  "https://example.com/img/krasova.jpg"
                ],
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "manufacturer": {
                "description": "Real manufacturer (not the reseller shop).",
                "example": "Agrostis Trávníky",
                "type": "string"
              },
              "name": {
                "description": "Product display name in the source's locale.",
                "example": "KRÁSKA – květnatá luční směs",
                "type": "string"
              },
              "observedAt": {
                "description": "ISO 8601 timestamp of the scrape that wrote this record.",
                "example": "2024-11-01T14:22:00.000Z",
                "type": "string"
              },
              "offerings": {
                "description": "Pack-size variants with pricing.",
                "items": {
                  "$ref": "#/components/schemas/Offering"
                },
                "type": "array"
              },
              "slug": {
                "description": "Source-side slug without the `{source}/` prefix.",
                "example": "krasova-kvetna-smes",
                "type": "string"
              },
              "source": {
                "description": "Scraper / source key that produced this record.",
                "example": "planta-mixes",
                "type": "string"
              },
              "tags": {
                "description": "Cross-cutting tags (function, site preference, properties).",
                "example": [
                  "low-maintenance",
                  "drought-tolerant"
                ],
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": {
                "description": "Multi-species seed mixture.",
                "enum": [
                  "mixture"
                ],
                "type": "string"
              },
              "url": {
                "description": "Canonical product page URL at the source.",
                "example": "https://example.com/krasova-kvetna-smes",
                "nullable": true,
                "type": "string"
              }
            },
            "required": [
              "id",
              "source",
              "manufacturer",
              "slug",
              "name",
              "categories",
              "composition",
              "offerings",
              "observedAt",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "_warnings": {
