  },
  "info": {
    "description": "Czech seed-mixture catalog API. Aggregates products from multiple Czech seed manufacturers (Planta Naturalis, Kvetnaté Louky, Agrogen, …) into a unified schema. Species are cross-referenced by the linker pass.",
    "title": "seed-mixer API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/categories": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoriesResponse"
                }
              }
            },
            "description": "Distinct categories sorted by product count descending."
          }
        },
        "summary": "List all categories with product counts",
        "tags": [
          "catalog"
        ]
      }
    },
    "/manufacturers": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManufacturersResponse"
                }
              }
            },
            "description": "Manufacturer roll-up sorted by product count descending."
          }
        },
        "summary": "List all manufacturers with product counts",
        "tags": [
          "catalog"
        ]
      }
    },
    "/products": {
      "get": {
        "description": "The `contains` parameter accepts either a canonical speciesId (exact, fast path) or any partial Latin/Czech name (resolved via fuzzy search). Multiple values are ANDed. Returns 400 with suggestions if a term cannot be resolved.",
        "parameters": [
          {
            "description": "Filter by product type.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "description": "Filter by product type.",
              "enum": [
                "mixture",
                "species"
              ],
              "example": "mixture",
              "type": "string"
            }
          },
          {
            "description": "Filter by manufacturer name (case-insensitive exact match).",
            "in": "query",
            "name": "manufacturer",
            "required": false,
            "schema": {
              "description": "Filter by manufacturer name (case-insensitive exact match).",
              "example": "Agrostis Trávníky",
              "type": "string"
            }
          },
          {
            "description": "Filter by scraper source key.",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "description": "Filter by scraper source key.",
              "example": "planta-mixes",
              "type": "string"
            }
          },
          {
            "description": "Filter by category (case-insensitive substring match).",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "description": "Filter by category (case-insensitive substring match).",
              "example": "medicinal",
              "type": "string"
            }
          },
          {
            "description": "Filter to mixtures that contain ALL listed species IDs (by Ingredient.speciesId). Repeat the param for multiple values: `?contains=trifolium-pratense&contains=festuca-rubra`.",
            "in": "query",
            "name": "contains",
            "required": false,
            "schema": {
              "description": "Filter to mixtures that contain ALL listed species IDs (by Ingredient.speciesId). Repeat the param for multiple values: `?contains=trifolium-pratense&contains=festuca-rubra`.",
              "example": [
                "trifolium-pratense"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductsResponse"
                }
              }
            },
            "description": "Paginated product summaries matching the supplied filters."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FuzzyResolveError"
                }
              }
            },
            "description": "A `contains` term could not be resolved to any known species."
          }
        },
        "summary": "List products (summary view, no description/composition)",
        "tags": [
          "products"
        ]
      }
    },
    "/products/{source}/{slug}": {
      "get": {
        "parameters": [
          {
            "description": "Scraper source key.",
            "in": "path",
            "name": "source",
            "required": true,
            "schema": {
              "description": "Scraper source key.",
              "example": "planta-mixes",
              "type": "string"
            }
          },
          {
            "description": "Product slug within that source.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "Product slug within that source.",
              "example": "krasova-kvetna-smes",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            },
            "description": "Full product record."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No product with that source/slug combination."
          }
        },
        "summary": "Get full product detail including composition",
        "tags": [
          "products"
        ]
      }
    },
    "/search": {
      "get": {
        "description": "Uses Orama BM25 full-text search with tolerance=1 (typo-tolerant). Strips diacritics before indexing, so \"jetel\" matches \"Červený jetel\" and \"jetel luční\". Canonical speciesId fragments (\"trifolium\") also work.",
        "parameters": [
          {
            "description": "Search term — Latin name, Czech name, or species ID fragment.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Search term — Latin name, Czech name, or species ID fragment.",
              "example": "jetel",
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Maximum number of hits to return (1–100, default 20).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Maximum number of hits to return (1–100, default 20).",
              "example": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Ranked species hits."
          }
        },
        "summary": "Fuzzy-search species by Latin name, Czech name, or partial ID",
        "tags": [
          "search"
        ]
      }
    },
    "/species": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeciesListResponse"
                }
              }
            },
            "description": "All canonical species entries."
          }
        },
        "summary": "List all species (summary view)",
        "tags": [
          "species"
        ]
      }
    },
    "/species/{id}": {
      "get": {
        "parameters": [
          {
            "description": "Canonical species identifier.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Canonical species identifier.",
              "example": "trifolium-pratense",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Species"
                }
              }
            },
            "description": "Full species record including growing conditions and product cross-refs."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No species with that ID."
          }
        },
        "summary": "Get a single species by canonical ID",
        "tags": [
          "species"
        ]
      }
    }
  }
}
