              "max"
            ],
            "type": "object"
          },
          "light": {
            "example": "full sun to partial shade",
            "type": "string"
          },
          "propagation": {
            "example": "seed, division",
            "type": "string"
          },
          "soil": {
            "example": "well-drained, loamy",
            "type": "string"
          },
          "water": {
            "example": "moderate",
            "type": "string"
          }
        },
        "type": "object"
      },
